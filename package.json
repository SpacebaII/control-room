{
  "name": "control-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply control-room-db --local",
    "db:remote": "wrangler d1 migrations apply control-room-db --remote",
    "types:worker": "wrangler types worker-configuration.d.ts --include-runtime false --strict-vars false",
    "types:check": "wrangler types worker-configuration.d.ts --include-runtime false --strict-vars false --check",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check": "npm run types:worker && npm run lint && npm run types:check && npm run typecheck && npm run test -- --coverage && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
